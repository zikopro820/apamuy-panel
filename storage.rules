rules_version = '2';
// =========================================================
// APAMUY — Reglas de Storage (fotos)
// Firebase → Storage → Reglas → borra todo, pega esto → Publicar.
// =========================================================
service firebase.storage {
  match /b/{bucket}/o {
    function imagen() { return request.resource.contentType.matches('image/.*') && request.resource.size < 3 * 1024 * 1024; }

    // Logo, portada, QR y fotos de platos: todos las ven, solo el dueño del negocio las sube
    match /negocios/{nid}/{resto=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == nid && imagen();
    }
    // Imágenes de la portada (rubros y banners): solo el admin
    match /web/{resto=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email in ['admin@apamuy.com'] && imagen();
    }
    function admin() { return request.auth != null && request.auth.token.email in ['admin@apamuy.com']; }
    function documento() { return (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf') && request.resource.size < 5 * 1024 * 1024; }
    // Documentos del repartidor (DNI, SOAT, antecedentes, firma): SOLO él y el admin. Nadie más, ni con el enlace.
    match /repartidores/{uid}/{archivo} {
      allow read: if request.auth != null && (request.auth.uid == uid || admin());
      allow create, update: if request.auth != null && request.auth.uid == uid && documento();
    }
    // Foto de perfil del repartidor (pública: la ven los clientes cuando el admin la aprueba)
    match /perfiles/{uid}/{archivo} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid && imagen();
    }
    // Capturas de los pagos del repartidor a Apamuy
    match /pagosrep/{uid}/{archivo} {
      allow read: if request.auth != null && (request.auth.uid == uid || admin());
      allow create: if request.auth != null && request.auth.uid == uid && imagen();
    }
    // Capturas de pago: solo el cliente las sube (el negocio las ve con el enlace del pedido)
    match /capturas/{uid}/{archivo} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.token.email in ['admin@apamuy.com']);
      allow create: if request.auth != null && request.auth.uid == uid && imagen();
    }
  }
}
