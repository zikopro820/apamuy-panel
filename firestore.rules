rules_version = '2';
// =========================================================
// APAMUY — Reglas de Firestore
// Firebase → Firestore Database → Reglas → borra todo, pega esto → Publicar.
// El correo del admin debe ser el MISMO de firebase-config.js (admins).
// =========================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function logueado() { return request.auth != null; }
    function admin() { return logueado() && request.auth.token.email in ['admin@apamuy.com']; }
    function d() { return request.resource.data; }
    function cambia(campos) { return request.resource.data.diff(resource.data).affectedKeys().hasAny(campos); }
    function soloCambia(campos) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos); }

    // Configuración general (comisión, tarifas de delivery): todos la leen, solo el admin la cambia
    match /config/{id} { allow read: if true; allow write: if admin(); }
    // Rubros (Comida, Farmacia, Talleres…) y banners de la portada: los edita solo el admin
    match /rubros/{id}  { allow read: if true; allow write: if admin(); }
    match /banners/{id} { allow read: if true; allow write: if admin(); }

    // Perfil del cliente: solo él (y el admin para verlo)
    match /usuarios/{uid} {
      allow read: if logueado() && (request.auth.uid == uid || admin());
      allow create, update: if logueado() && request.auth.uid == uid
        && d().keys().hasOnly(['nombre', 'email', 'celular', 'direcciones', 'creado'])
        && d().get('direcciones', []).size() <= 10;
      allow delete: if false;
    }

    // Negocios: el id del documento es el uid del dueño
    match /negocios/{nid} {
      function dueno() { return logueado() && request.auth.uid == nid; }
      function ejemplo() { return admin() && nid.matches('demo-.*'); }   // tiendas de ejemplo: las maneja el admin
      allow read: if dueno() || admin() || resource.data.estado == 'activo';
      allow create: if ejemplo() || (dueno() && d().owner == nid && d().estado == 'pendiente'
        && !('comision' in d()) && !('aprobado' in d()) && !('motivo' in d()));
      // El dueño edita sus datos, pero NO su estado ni su comisión. El admin SOLO cambia estado y comisión.
      allow update: if ejemplo() || (dueno() && !cambia(['estado', 'owner', 'email', 'comision', 'aprobado', 'motivo', 'revisado', 'bloqueoCobro']))
                    || (admin() && soloCambia(['estado', 'comision', 'motivo', 'revisado', 'aprobado', 'bloqueoCobro']));
      allow delete: if admin();

      // Carta: todos la ven, SOLO el dueño la edita (el admin no)
      match /categorias/{id} { allow read: if true; allow write: if (logueado() && request.auth.uid == nid) || ejemplo(); }
      match /productos/{id}  { allow read: if true; allow write: if (logueado() && request.auth.uid == nid) || ejemplo(); }
      // Caja del negocio
      match /movimientos/{id} { allow read: if (logueado() && request.auth.uid == nid) || admin(); allow write: if logueado() && request.auth.uid == nid; }
    }

    // ---------- Repartidores ----------
    function repDe(uid) { return get(/databases/$(database)/documents/repartidores/$(uid)).data; }
    function repActivo() { return logueado() && exists(/databases/$(database)/documents/repartidores/$(request.auth.uid)) && repDe(request.auth.uid).estado == 'activo'; }

    // Ficha del repartidor (DNI, domicilio…): solo él y el admin
    match /repartidores/{uid} {
      function yo() { return logueado() && request.auth.uid == uid; }
      allow read: if yo() || admin();
      allow create: if yo() && d().estado == 'pendiente' && d().consentimiento == true
        && !('aprobado' in d()) && !('motivo' in d()) && !('revisado' in d());
      // Él edita sus datos (disponible, ubicación, SOAT) pero NO su estado. Si lo rechazaron, puede reenviar para revisión.
      allow update: if (yo() && !cambia(['estado', 'aprobado', 'motivo', 'revisado', 'email', 'fotoPerfil']))
                    || (yo() && resource.data.estado == 'rechazado' && d().estado == 'pendiente' && !cambia(['aprobado', 'revisado', 'email']))
                    || (admin() && soloCambia(['estado', 'motivo', 'revisado', 'aprobado', 'disponible', 'fotoPerfil', 'fotoNueva']));
      allow delete: if admin();
    }

    // Ofertas: lo que ven TODOS los repartidores de la ciudad (negocio, zona, distancia, cuánto ganan). Sin datos del cliente.
    match /ofertas/{oid} {
      function delNegocio() { return logueado() && (resource.data.negocioId == request.auth.uid || (admin() && resource.data.negocioId.matches('demo-.*'))); }
      allow read: if logueado() && (resource.data.negocioId == request.auth.uid || admin() || (repActivo() && repDe(request.auth.uid).prov == resource.data.prov));
      allow create: if logueado() && d().codigo == oid && d().estado == 'libre'
        && (d().negocioId == request.auth.uid || (admin() && d().negocioId.matches('demo-.*')));
      allow update: if (delNegocio() && d().negocioId == resource.data.negocioId)
        // Tomarla: solo si está libre, el repartidor está activo y tiene el vehículo correcto
        || (repActivo() && resource.data.estado == 'libre' && d().estado == 'tomado' && d().tomadoPor == request.auth.uid
            && soloCambia(['estado', 'tomadoPor', 'tomado'])
            && (resource.data.vehiculo == 'todos' || resource.data.vehiculo == repDe(request.auth.uid).vehiculo))
        // Soltarla (no puede llevarla)
        || (logueado() && resource.data.get('tomadoPor', null) == request.auth.uid && d().estado == 'libre' && d().tomadoPor == null && soloCambia(['estado', 'tomadoPor', 'soltadoPor']));
      allow delete: if false;
    }

    // Perfil PÚBLICO del repartidor (lo ve el cliente): foto aprobada, nombre corto, vehículo, placa, entregas y estrellas
    match /repPublico/{uid} {
      function cal() { return getAfter(/databases/$(database)/documents/calificaciones/$(d().ultimaCal)).data; }
      allow read: if true;
      allow create: if admin();
      allow update: if admin()
        || (logueado() && request.auth.uid == uid && soloCambia(['entregas']) && d().entregas == resource.data.get('entregas', 0) + 1)
        // Una calificación nueva suma sus estrellas (solo la del cliente de ese pedido, una sola vez)
        || (logueado() && soloCambia(['estrellasSum', 'estrellasN', 'ultimaCal'])
            && !exists(/databases/$(database)/documents/calificaciones/$(d().ultimaCal))
            && cal().repUid == uid && cal().uid == request.auth.uid
            && d().estrellasN == resource.data.get('estrellasN', 0) + 1 && d().estrellasSum == resource.data.get('estrellasSum', 0) + cal().estrellas);
      allow delete: if admin();
    }

    // Calificaciones (1 a 5 estrellas): solo el cliente de un pedido o envío ENTREGADO por ese repartidor
    match /calificaciones/{ref} {
      allow get: if logueado();
      allow list: if admin() || (logueado() && resource.data.repUid == request.auth.uid);
      allow create: if logueado() && d().uid == request.auth.uid && d().ref == ref && d().col in ['pedidos', 'envios']
        && d().estrellas is int && d().estrellas >= 1 && d().estrellas <= 5 && d().comentario.size() <= 200
        && get(/databases/$(database)/documents/$(d().col)/$(ref)).data.clienteUid == request.auth.uid
        && get(/databases/$(database)/documents/$(d().col)/$(ref)).data.repUid == d().repUid
        && get(/databases/$(database)/documents/$(d().col)/$(ref)).data.estado == 'entregado';
      allow update, delete: if admin();
    }

    // DNI verificado con RENIEC: solo lo escribe el servidor (función verificarDni)
    match /verificaciones/{uid} {
      allow read: if logueado() && (request.auth.uid == uid || admin());
      allow write: if false;
    }

    // 💰 Comisión semanal de los negocios (la crea el servidor cada lunes; el negocio sube su pago; el admin aprueba)
    match /liquidaciones/{lid} {
      allow read: if logueado() && (resource.data.negocioId == request.auth.uid || admin());
      allow create, delete: if admin();
      allow update: if admin()
        || (logueado() && resource.data.negocioId == request.auth.uid && resource.data.estado == 'pendiente' && d().estado == 'revision'
            && soloCambia(['estado', 'pago', 'rechazo', 'actualizado']) && d().pago.captura is string && d().pago.captura.size() < 500000);
    }

    // 🔍 Buscar repuesto / 🚨 Auxilio: el cliente pregunta y las ferreterías y talleres de SU provincia responden.
    // Sin nombre completo ni celular del cliente (eso solo lo ve la tienda que elige, en el pedido).
    match /solicitudes/{sid} {
      function miNeg() { return get(/databases/$(database)/documents/negocios/$(request.auth.uid)).data; }
      allow read: if logueado() && (resource.data.clienteUid == request.auth.uid || admin()
        || (exists(/databases/$(database)/documents/negocios/$(request.auth.uid)) && miNeg().estado == 'activo' && miNeg().prov == resource.data.prov));
      allow create: if logueado() && d().clienteUid == request.auth.uid && d().codigo == sid && d().estado == 'abierta'
        && d().tipo in ['repuesto', 'auxilio'] && d().texto is string && d().texto.size() <= 300 && d().rubros is list && d().rubros.size() <= 10
        && (!('foto' in d()) || (d().foto is string && d().foto.size() < 300000))
        && d().keys().hasOnly(['codigo', 'tipo', 'clienteUid', 'cliente', 'prov', 'rubros', 'texto', 'problema', 'foto', 'vehiculo', 'zona', 'ubic', 'estado', 'vence', 'creado', 'dia', 'mes']);
      // El cliente la cancela, o elige una tienda (en la misma operación crea su pedido en esa tienda)
      allow update: if logueado() && resource.data.clienteUid == request.auth.uid && (
          (resource.data.estado == 'abierta' && d().estado == 'cancelada' && soloCambia(['estado', 'actualizado']))
          || (resource.data.estado in ['abierta', 'cerrada'] && d().estado == 'elegida' && soloCambia(['estado', 'elegida', 'pedido', 'actualizado'])
              && getAfter(/databases/$(database)/documents/pedidos/$(d().pedido)).data.solicitud == sid
              && getAfter(/databases/$(database)/documents/pedidos/$(d().pedido)).data.negocioId == d().elegida
              && getAfter(/databases/$(database)/documents/pedidos/$(d().pedido)).data.clienteUid == request.auth.uid));
      allow delete: if false;

      // «Sí tengo»: una respuesta por negocio (id = uid del negocio)
      match /respuestas/{nid} {
        function sol() { return get(/databases/$(database)/documents/solicitudes/$(sid)).data; }
        function neg() { return get(/databases/$(database)/documents/negocios/$(nid)).data; }
        allow read: if logueado() && (request.auth.uid == nid || admin() || sol().clienteUid == request.auth.uid);
        allow create, update: if logueado() && request.auth.uid == nid && d().negocioId == nid && sol().estado == 'abierta'
          && neg().estado == 'activo' && neg().get('bloqueoCobro', false) != true && neg().prov == sol().prov && neg().rubro in sol().rubros
          && d().precio is number && d().precio > 0 && d().precio < 100000
          && (!('foto' in d()) || (d().foto is string && d().foto.size() < 300000))
          && d().keys().hasOnly(['negocioId', 'negocio', 'precio', 'calidad', 'nota', 'foto', 'llegaMin', 'creado', 'actualizado']);
        allow delete: if logueado() && request.auth.uid == nid;
      }
    }

    // Envíos de paquetes: el cliente pone el precio; los repartidores aceptan o contraofertan
    match /envios/{eid} {
      function cliente() { return logueado() && resource.data.clienteUid == request.auth.uid; }
      function suRep() { return logueado() && resource.data.get('repUid', null) == request.auth.uid; }
      allow read: if logueado() && (resource.data.clienteUid == request.auth.uid || admin() || resource.data.repUid == request.auth.uid
        || (repActivo() && repDe(request.auth.uid).prov == resource.data.prov && resource.data.estado == 'buscando'));
      allow create: if logueado() && d().clienteUid == request.auth.uid && d().codigo == eid && d().estado == 'buscando'
        && d().oferta is number && d().oferta >= 1 && d().oferta < 5000 && d().tamano in ['sobre', 'pequeno', 'grande'] && d().paga in ['envia', 'recibe']
        && d().keys().hasOnly(['codigo', 'clienteUid', 'origen', 'destino', 'prov', 'interprov', 'km', 'tamano', 'contenido', 'paga', 'oferta', 'sugerido', 'estado', 'buscadoEn', 'rastreo', 'creado', 'dia', 'mes']);
      allow update: if
        // Cliente: sube su oferta / vuelve a buscar
        (cliente() && resource.data.estado == 'buscando' && d().estado == 'buscando' && soloCambia(['oferta', 'buscadoEn', 'actualizado']) && d().oferta is number && d().oferta < 5000)
        // Cliente: cancela antes de que recojan el paquete
        || (cliente() && resource.data.estado in ['buscando', 'asignado'] && d().estado == 'cancelado' && soloCambia(['estado', 'actualizado']))
        // Cliente: elige una contraoferta (el precio debe ser el que mandó ese repartidor)
        || (cliente() && resource.data.estado == 'buscando' && d().estado == 'asignado' && d().repartidor.uid == d().repUid
            && get(/databases/$(database)/documents/envios/$(eid)/ofertas/$(d().repUid)).data.precio == d().precio
            && soloCambia(['estado', 'repUid', 'repartidor', 'precio', 'asignadoEn', 'actualizado']))
        // Repartidor: acepta el precio del cliente
        || (repActivo() && resource.data.estado == 'buscando' && d().estado == 'asignado' && d().repUid == request.auth.uid && d().repartidor.uid == request.auth.uid
            && d().precio == resource.data.oferta && repDe(request.auth.uid).prov == resource.data.prov
            && (resource.data.tamano != 'grande' || repDe(request.auth.uid).vehiculo == 'carro')
            && soloCambia(['estado', 'repUid', 'repartidor', 'precio', 'asignadoEn', 'actualizado']))
        // Su repartidor: ubicación, «recogí» y «entregado»; o soltarlo antes de recoger
        || (suRep() && soloCambia(['estado', 'repartidor', 'recogido', 'entregado', 'actualizado', 'repUid', 'precio', 'buscadoEn'])
            && ((d().repUid == request.auth.uid && d().repartidor.uid == request.auth.uid && !cambia(['precio', 'repUid'])
                 && (!cambia(['estado']) || (d().estado == 'camino' && resource.data.estado == 'asignado') || (d().estado == 'entregado' && resource.data.estado == 'camino')))
              || (resource.data.estado == 'asignado' && d().estado == 'buscando' && d().repUid == null && d().repartidor == null)));
      allow delete: if false;

      // Datos privados (celulares de quien envía y recibe): cliente, SU repartidor y admin
      match /priv/{doc} {
        function env() { return get(/databases/$(database)/documents/envios/$(eid)).data; }
        allow read: if logueado() && (env().clienteUid == request.auth.uid || env().get('repUid', null) == request.auth.uid || admin());
        allow create: if logueado() && d().clienteUid == request.auth.uid && getAfter(/databases/$(database)/documents/envios/$(eid)).data.clienteUid == request.auth.uid;
        allow update, delete: if false;
      }
      // Contraofertas: una por repartidor (id = su uid)
      match /ofertas/{rid} {
        allow read: if logueado() && (request.auth.uid == rid || admin() || get(/databases/$(database)/documents/envios/$(eid)).data.clienteUid == request.auth.uid);
        allow create, update: if repActivo() && request.auth.uid == rid && d().repUid == rid && d().rep.uid == rid && d().precio is number && d().precio >= 1 && d().precio < 5000
          && get(/databases/$(database)/documents/envios/$(eid)).data.estado == 'buscando';
        allow delete: if logueado() && request.auth.uid == rid;
      }
    }

    // Rastreo público: enlace secreto para compartir (se abre sin cuenta, pero NO se puede listar)
    match /rastreo/{t} {
      allow get: if true;
      allow list: if false;
      allow create: if logueado() && d().uid == request.auth.uid && d().col in ['pedidos', 'envios'];
      allow update: if (logueado() && resource.data.uid == request.auth.uid && !cambia(['uid', 'col', 'ref']))
        || (logueado() && getAfter(/databases/$(database)/documents/$(resource.data.col)/$(resource.data.ref)).data.get('repUid', null) == request.auth.uid
            && soloCambia(['estado', 'repartidor', 'ubic', 'actualizado']));
      allow delete: if false;
    }

    // Celulares que reciben avisos (token de notificaciones). Solo los lee el servidor; cada uno registra el suyo.
    match /fcm/{token} {
      allow create, update: if logueado() && d().uid == request.auth.uid && d().app in ['web', 'panel', 'rep']
        && d().keys().hasOnly(['uid', 'app', 'email', 'ua', 'actualizado']) && (!('email' in d()) || d().email == request.auth.token.email);
      allow delete: if logueado() && resource.data.uid == request.auth.uid;
      allow read: if false;
    }

    // Libro de Reclamaciones virtual: cualquiera puede dejar su hoja (sin cuenta). Numeración correlativa. Solo el admin las lee.
    match /contadores/{id} {
      allow get: if id == 'reclamos';
      allow create: if id == 'reclamos' && d().n == 1 && d().keys().hasOnly(['n']) && existsAfter(/databases/$(database)/documents/reclamos/LR-1);
      allow update: if id == 'reclamos' && d().n == resource.data.n + 1 && d().keys().hasOnly(['n'])
        && existsAfter(/databases/$(database)/documents/reclamos/$('LR-' + string(d().n)));
    }
    match /reclamos/{rid} {
      allow read: if admin();
      allow create: if rid == 'LR-' + string(d().numero) && d().codigo == rid && d().estado == 'pendiente'
        && getAfter(/databases/$(database)/documents/contadores/reclamos).data.n == d().numero
        && d().tipo in ['Reclamo', 'Queja'] && d().detalle is string && d().detalle.size() <= 2000 && d().pedidoConsumidor.size() <= 1000
        && d().consumidor.nombre is string && d().consumidor.email is string;
      allow update: if admin();
      allow delete: if false;
    }

    // Pagos del % que hace el repartidor a Apamuy
    match /pagosRep/{id} {
      allow read: if logueado() && (resource.data.uid == request.auth.uid || admin());
      allow create: if logueado() && d().uid == request.auth.uid && d().estado == 'pendiente' && d().monto is number && d().dias is list && d().dias.size() <= 62;
      allow update: if admin() && soloCambia(['estado', 'motivo', 'revisado']);
      allow delete: if false;
    }

    // Pedidos: los ve el cliente que lo hizo, el negocio que lo recibe, su repartidor y el admin
    match /pedidos/{pid} {
      allow read: if logueado() && (resource.data.clienteUid == request.auth.uid || resource.data.negocioId == request.auth.uid || admin() || resource.data.repUid == request.auth.uid);
      allow create: if logueado() && d().clienteUid == request.auth.uid && d().codigo == pid
        && get(/databases/$(database)/documents/negocios/$(d().negocioId)).data.estado == 'activo'
        && get(/databases/$(database)/documents/negocios/$(d().negocioId)).data.get('bloqueoCobro', false) != true
        && d().keys().hasOnly(['codigo', 'negocioId', 'negocio', 'clienteUid', 'cliente', 'items', 'subtotal', 'envio', 'km', 'total', 'entrega', 'destino', 'nota',
             'pago', 'operacion', 'montoLeido', 'coincide', 'fechaOk', 'pagaCon', 'captura', 'estado', 'dia', 'mes', 'creado', 'servicio', 'mayorEdad', 'solicitud', 'comprobante'])
        && d().estado in ['nuevo', 'por-validar'] && (d().estado == 'nuevo') == (d().pago in ['Efectivo', 'A coordinar'])
        && d().entrega in ['delivery', 'recojo', 'servicio']
        && d().items is list && d().items.size() > 0 && d().items.size() <= 60
        && d().subtotal is number && (d().subtotal > 0 || d().entrega == 'servicio') && d().total is number && d().total >= d().subtotal && d().total < 10000;
      // Solo el negocio avanza los estados; no puede cambiar lo que pidió el cliente ni los montos
      allow update: if (logueado() && resource.data.clienteUid == request.auth.uid && soloCambia(['rastreo']) && !('rastreo' in resource.data))
        || (logueado() && (resource.data.negocioId == request.auth.uid || (admin() && resource.data.negocioId.matches('demo-.*')))
        && !cambia(['codigo', 'negocioId', 'clienteUid', 'cliente', 'items', 'subtotal', 'envio', 'total', 'destino', 'creado', 'dia', 'mes', 'comprobante']))
        // El repartidor lo toma: solo si nadie lo tiene y ganó la oferta en la misma operación
        || (repActivo() && resource.data.get('repUid', null) == null && d().repUid == request.auth.uid && d().repartidor.uid == request.auth.uid
            && getAfter(/databases/$(database)/documents/ofertas/$(pid)).data.tomadoPor == request.auth.uid
            && soloCambia(['repUid', 'repartidor', 'actualizado']))
        // Su repartidor: ubicación en vivo, «recogí» (camino) y «entregado». O soltarlo antes de recogerlo.
        || (logueado() && resource.data.get('repUid', null) == request.auth.uid
            && soloCambia(['repUid', 'repartidor', 'estado', 'despachado', 'entregado', 'actualizado'])
            && ((d().repUid == request.auth.uid && d().repartidor.uid == request.auth.uid
                 && (!cambia(['estado']) || (d().estado == 'camino' && resource.data.estado in ['cocina', 'listo']) || (d().estado == 'entregado' && resource.data.estado == 'camino')))
              || (d().repUid == null && d().repartidor == null && !cambia(['estado']) && resource.data.estado in ['cocina', 'listo'])));
      allow delete: if false;
    }
  }
}
