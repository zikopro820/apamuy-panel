rules_version = '2';
// =========================================================
// APAMUY — Reglas de Firestore
// Firebase → Firestore Database → Reglas → borra todo, pega esto → Publicar.
// El correo del admin debe ser el MISMO de firebase-config.js (admins).
// =========================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function logueado() { return request.auth != null; }
    function admin() { return logueado() && request.auth.token.email in ['admin@apamuy.com']; }
    function d() { return request.resource.data; }
    function cambia(campos) { return request.resource.data.diff(resource.data).affectedKeys().hasAny(campos); }
    function soloCambia(campos) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos); }

    // Configuración general (comisión, tarifas de delivery): todos la leen, solo el admin la cambia
    match /config/{id} { allow read: if true; allow write: if admin(); }

    // Perfil del cliente: solo él (y el admin para verlo)
    match /usuarios/{uid} {
      allow read: if logueado() && (request.auth.uid == uid || admin());
      allow create, update: if logueado() && request.auth.uid == uid
        && d().keys().hasOnly(['nombre', 'email', 'celular', 'direcciones', 'creado'])
        && d().get('direcciones', []).size() <= 10;
      allow delete: if false;
    }

    // Negocios: el id del documento es el uid del dueño
    match /negocios/{nid} {
      function dueno() { return logueado() && request.auth.uid == nid; }
      allow read: if dueno() || admin() || resource.data.estado == 'activo';
      allow create: if dueno() && d().owner == nid && d().estado == 'pendiente'
        && !('comision' in d()) && !('aprobado' in d()) && !('motivo' in d());
      // El dueño edita sus datos, pero NO su estado ni su comisión. El admin SOLO cambia estado y comisión.
      allow update: if (dueno() && !cambia(['estado', 'owner', 'email', 'comision', 'aprobado', 'motivo', 'revisado']))
                    || (admin() && soloCambia(['estado', 'comision', 'motivo', 'revisado', 'aprobado']));
      allow delete: if admin();

      // Carta: todos la ven, SOLO el dueño la edita (el admin no)
      match /categorias/{id} { allow read: if true; allow write: if logueado() && request.auth.uid == nid; }
      match /productos/{id}  { allow read: if true; allow write: if logueado() && request.auth.uid == nid; }
      // Caja del negocio
      match /movimientos/{id} { allow read: if (logueado() && request.auth.uid == nid) || admin(); allow write: if logueado() && request.auth.uid == nid; }
    }

    // Pedidos: los ve el cliente que lo hizo, el negocio que lo recibe y el admin
    match /pedidos/{pid} {
      allow read: if logueado() && (resource.data.clienteUid == request.auth.uid || resource.data.negocioId == request.auth.uid || admin());
      allow create: if logueado() && d().clienteUid == request.auth.uid && d().codigo == pid
        && get(/databases/$(database)/documents/negocios/$(d().negocioId)).data.estado == 'activo'
        && d().keys().hasOnly(['codigo', 'negocioId', 'negocio', 'clienteUid', 'cliente', 'items', 'subtotal', 'envio', 'km', 'total', 'entrega', 'destino', 'nota',
             'pago', 'operacion', 'montoLeido', 'coincide', 'fechaOk', 'pagaCon', 'captura', 'estado', 'dia', 'mes', 'creado'])
        && d().estado in ['nuevo', 'por-validar'] && (d().estado == 'nuevo') == (d().pago == 'Efectivo')
        && d().entrega in ['delivery', 'recojo']
        && d().items is list && d().items.size() > 0 && d().items.size() <= 60
        && d().subtotal is number && d().subtotal > 0 && d().total is number && d().total >= d().subtotal && d().total < 10000;
      // Solo el negocio avanza los estados; no puede cambiar lo que pidió el cliente ni los montos
      allow update: if logueado() && resource.data.negocioId == request.auth.uid
        && !cambia(['codigo', 'negocioId', 'clienteUid', 'cliente', 'items', 'subtotal', 'envio', 'total', 'destino', 'creado', 'dia', 'mes']);
      allow delete: if false;
    }
  }
}
